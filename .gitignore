# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
*.egg-info/
.eggs/
pip-wheel-metadata/

# --- Jupyter ---
.ipynb_checkpoints/

# --- Environment / secrets ---
.env
.env.local
*.local

# --- Datasets (large, obtained separately, not committed) ---
ml/datasets/raw/*
!ml/datasets/raw/.gitkeep
ml/datasets/raw_labelled_flows/*
!ml/datasets/raw_labelled_flows/.gitkeep
ml/datasets/processed/*
!ml/datasets/processed/.gitkeep

# --- Generated attack graph artifacts (large; regenerate via
# `python -m attack_graph.run_pipeline`, don't commit) ---
attack_graph/output/

# --- Generated risk-engine evaluation artifacts (regenerate via
# `python -m risk_engine.run_pipeline`, don't commit) ---
risk_engine/output/

# --- Trained model artifacts (large binaries; keep code, not weights) ---
ml/models/*.pt
ml/models/*.pth
ml/models/*.pkl
ml/models/*.joblib
ml/models/*.h5
ml/models/*.onnx
ml/models/artifacts/

# --- IDE / editor ---
.vscode/
.idea/
*.swp
*.swo

# --- Claude Code session/tooling state (not project content) ---
.claude/

# --- Pytest ---
.pytest_cache/

# --- OS ---
Thumbs.db
.DS_Store
desktop.ini

# --- Logs / reports generated at runtime ---
*.log
logs/
docs/generated/

# --- Future backend/frontend (placeholders, keep out until those phases exist) ---
node_modules/
dist/
build/
*.egg-info/
