# victim_agent configuration. Copy this file to victim_agent/.env and fill
# in real values. Never commit the real .env (already covered by the
# repo's root .gitignore pattern for any file literally named .env).
#
# This file is independent of the Admin's own project-root .env -- the
# victim laptop this runs on has no access to that file at all.

# The Admin backend's own LAN address, e.g. http://192.168.56.10:8000
# (never localhost/127.0.0.1 -- that would point at the victim laptop
# itself). Required, no default -- the Admin's IP is never hardcoded.
ADMIN_BASE_URL=

# One-time shared secret, given to you out-of-band by the Admin operator
# (matches AGENT_ENROLLMENT_KEY in the Admin's own .env). Only used for
# this agent's FIRST registration -- once victim_agent/.agent_identity.json
# holds a token, this value is no longer read. Blank it out (or leave it)
# after first successful registration if you like; it's not needed again
# unless you delete the identity file.
AGENT_ENROLLMENT_KEY=

# Optional: force a specific stable agent_id (e.g. "victim-01"). If left
# blank, a UUID is generated once and persisted to the identity file below
# -- it will NOT change on restart.
AGENT_ID=

HEARTBEAT_INTERVAL_SECONDS=15
TELEMETRY_INTERVAL_SECONDS=5
REQUEST_TIMEOUT_SECONDS=5
MAX_QUEUE_SIZE=1000

# Where the local identity (agent_id + token, once obtained) is persisted.
# Defaults to victim_agent/.agent_identity.json if left blank.
IDENTITY_FILE_PATH=

LOG_LEVEL=INFO
