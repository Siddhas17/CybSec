# Intelligent Cybersecurity System Using Attack Graphs
# Copy this file to .env and fill in real values. Never commit .env itself.

# ---------------------------------------------------------------------------
# ACTIVE (Phase 0+): core ML / attack-graph pipeline
# ---------------------------------------------------------------------------

# Root paths (relative to project root unless absolute)
DATASET_RAW_DIR=ml/datasets/raw
DATASET_PROCESSED_DIR=ml/datasets/processed
MODEL_DIR=ml/models

# Which dataset the pipeline is currently configured for
# (set once a dataset is chosen and downloaded — see docs/dataset_selection.md)
ACTIVE_DATASET=

# Autoencoder training
RANDOM_SEED=42
TRAIN_SPLIT=0.7
VAL_SPLIT=0.15
TEST_SPLIT=0.15

# Logging
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# ACTIVE (Phase 5): backend API (FastAPI)
# ---------------------------------------------------------------------------

API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------------------------------------------------------------------------
# ACTIVE (Phase 5): database (MySQL)
#
# If MySQL runs on native Windows while the backend runs in WSL2 (this
# project's setup — see docs/application_architecture.md), MYSQL_HOST is
# the WSL2->Windows gateway IP (`ip route | grep default` inside WSL2), not
# "localhost" — it can change between WSL restarts. If MySQL runs inside
# WSL2 itself instead, "localhost" is correct.
# ---------------------------------------------------------------------------

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=attack_graph_app
MYSQL_USER=attack_graph_app
MYSQL_PASSWORD=changeme
DATABASE_URL=mysql+pymysql://attack_graph_app:changeme@127.0.0.1:3306/attack_graph_app

# ---------------------------------------------------------------------------
# ACTIVE (Phase 5): authentication
# ---------------------------------------------------------------------------

JWT_SECRET_KEY=generate-a-long-random-string-do-not-reuse-this-one
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme

# ---------------------------------------------------------------------------
# ACTIVE (Phase 5): analytical-core artifact paths
# ---------------------------------------------------------------------------

MODEL_PATH=ml/models/artifacts/autoencoder
RISK_CONFIG_PATH=risk_engine/output/config.json

# ---------------------------------------------------------------------------
# ACTIVE (Phase 6): live sensor (sensor/config.py)
#
# TELEMETRY_ENABLED is the master switch -- the sensor never captures on
# its own even if the backend is running; POST /api/v1/admin/sensor/start
# is always also required. Defaults to false. See docs/live_telemetry.md.
# ---------------------------------------------------------------------------

TELEMETRY_ENABLED=false
TELEMETRY_INTERFACE=lo

FLOW_IDLE_TIMEOUT_SECONDS=30.0
FLOW_MAX_DURATION_SECONDS=300.0
FLOW_MAX_PACKETS=200000
ACTIVITY_IDLE_THRESHOLD_SECONDS=5.0

LIVE_GRAPH_WINDOW_SECONDS=3600.0
LIVE_GRAPH_MAX_EDGES=5000
LIVE_GRAPH_CLEANUP_INTERVAL_SECONDS=60.0

MAX_QUEUED_PACKET_EVENTS=20000

# ---------------------------------------------------------------------------
# ACTIVE (Phase 7): controlled lab response (backend/app/services/prevention/)
#
# PREVENTION_ENABLED and PREVENTION_DRY_RUN are independent master switches
# -- both default to the safe state, and actual blocking requires an
# explicit change to BOTH. See docs/prevention.md.
# ---------------------------------------------------------------------------

PREVENTION_ENABLED=false
PREVENTION_DRY_RUN=true

RESPONSE_ALERT_THRESHOLD=7.0
RESPONSE_BLOCK_THRESHOLD=9.0

# Comma-separated CIDRs a response action's target IP must fall inside
# (example only -- set this to your own isolated lab network, never a
# shared or production range).
LAB_NETWORK_CIDRS=192.168.56.0/24
# Loopback targets are rejected by default even in a loopback-only sensor
# lab (docs/live_telemetry.md section 1) -- opt in explicitly for testing.
LAB_ALLOW_LOOPBACK_TARGET=false

# --- Lab network addressing (example only, never hard-code real values) ---
# LAB_KALI_IP=
# LAB_VICTIM1_IP=
# LAB_VICTIM2_IP=
# LAB_ADMIN_IP=
